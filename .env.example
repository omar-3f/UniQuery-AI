[TEMPLATE]
# Optional. Without a key the site still answers every admission question from
# src/data/university.js with the built-in data engine. With a key, Google
# Gemini answers (same data + saved student profile + chat memory).
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# Keep the real key in .env (never commit it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
